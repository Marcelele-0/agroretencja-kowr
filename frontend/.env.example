# Adres backendu FastAPI (/api/analyze, /api/report.pdf, /rl/recommend).
# Bez tej zmiennej (domyślnie) = "/" – proxy Vite (pnpm dev / pnpm preview) do backendu na 127.0.0.1:8000.
# Pełny adres, np. https://api.twoj-serwis.pl = backend na innym serwerze.
# Puste (VITE_API_URL=) = tylko ocena IUNG liczona w przeglądarce, bez kroków serwera.
VITE_API_URL=/
