<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<title>AgroRetencja KOWR – raport działki {{ r.parcel.parcel_id }}</title>
<style>
  @page { size: A4; margin: 14mm 13mm 16mm 13mm;
          @bottom-center { content: "AgroRetencja KOWR · {{ r.parcel.parcel_id }} · strona " counter(page) " z " counter(pages); font-size: 7.5pt; color: #666; } }
  body { font-family: "DejaVu Sans", Arial, sans-serif; font-size: 9pt; color: #1b2a22; line-height: 1.35; }
  h1 { font-size: 15pt; margin: 0 0 2mm; color: #12422b; }
  h2 { font-size: 11pt; margin: 4mm 0 1.5mm; color: #12422b; border-bottom: 1px solid #b9d3c3; padding-bottom: 0.8mm; }
  .meta { color: #4a5a50; font-size: 8.5pt; }
  .row { display: flex; gap: 5mm; }
  .col { flex: 1; }
  .badge { display: inline-block; padding: 1mm 2.5mm; border-radius: 2mm; font-weight: bold; }
  .r-niskie { background: #d8f0df; } .r-umiarkowane { background: #fff1c2; }
  .r-wysokie { background: #ffd9b8; } .r-krytyczne { background: #ffc4c4; }
  table { width: 100%; border-collapse: collapse; font-size: 8pt; margin-top: 1mm; }
  th, td { border-bottom: 1px solid #dfe8e2; padding: 0.8mm 1.2mm; text-align: left; vertical-align: top; }
  th { background: #eef5f0; }
  .big { font-size: 20pt; font-weight: bold; color: #12422b; }
  .small { font-size: 7.5pt; color: #4a5a50; }
  .advice { margin: 1mm 0; padding: 1.5mm 2mm; border-left: 2.5px solid #2f7d55; background: #f4f9f6; }
  .p1 { border-left-color: #c0392b; } .p2 { border-left-color: #e67e22; }
  img.map { width: 100%; border: 1px solid #ccd; }
  .page-break { page-break-before: always; }
</style>
</head>
<body>
<h1>Ocena wody na działce {{ r.parcel.parcel_id }}</h1>
<div class="meta">
  {{ r.parcel.voivodeship or "" }} · {{ r.parcel.county or "" }} · {{ r.parcel.commune or "" }} · obręb {{ r.parcel.region or "–" }} ·
  {{ "%.2f"|format(r.parcel.area_ha) }} ha (z granic działki) · uprawa: {{ crop_label }} · data analizy: {{ a.analysis_date }} ·
  wygenerowano {{ generated }}
</div>

<h2>1. Ocena sytuacji wodnej</h2>
<div class="row">
  <div class="col">
    <div class="big">{{ "%+.1f"|format(a.water_state) }}</div>
    <div class="small">stan wody w skali −5 (bardzo sucho) … +5 (bardzo mokro)</div>
    <p>WaterScore <b>{{ "%.0f"|format(a.water_score.total) }}/100</b> ·
      ryzyko <span class="badge r-{{ a.water_risk.level.value }}">{{ a.water_risk.level.value }}</span> ·
      pewność danych: <b>{{ a.confidence.level.value }}</b></p>
    <p>{{ a.summary_text }}</p>
    {% if a.water_risk.veto_reasons %}<p><b>Weto:</b> {{ a.water_risk.veto_reasons|join("; ") }}</p>{% endif %}
  </div>
  <div class="col">
    <table>
      <tr><th>Wskaźnik</th><th>Wartość</th></tr>
      <tr><td>Zapas wody (strefa korzeniowa)</td><td>{{ "%.0f"|format(a.storage_pct_taw or 0) }}% z {{ "%.0f"|format(a.taw_mm) }} mm</td></tr>
      <tr><td>KBW {{ a.kbw_period_label or "" }}</td><td>{% if a.kbw_mm is not none %}{{ "%.0f"|format(a.kbw_mm) }} mm{% if a.kbw_threshold_mm is not none %} (próg {{ "%.0f"|format(a.kbw_threshold_mm) }} mm){% endif %}{% else %}brak{% endif %}</td></tr>
      <tr><td>Susza wg progów IUNG (ostatnie okno)</td><td>{% if a.kbw_is_drought is none %}brak rozstrzygnięcia{% elif a.kbw_is_drought %}tak{% else %}nie{% endif %}</td></tr>
      <tr><td>Gleba</td><td>kat. {{ a.iung_category.value }} – {{ a.soil_source_layer }}</td></tr>
      <tr><td>Teren</td><td>spadek {{ "%.1f"|format(a.mean_slope_deg) }}°, spływ 60 dni {{ "%.0f"|format(a.runoff_60d_mm or 0) }} mm</td></tr>
      <tr><td>Satelita NDMI</td><td>{% if a.ndmi_value is not none %}{{ "%.2f"|format(a.ndmi_value) }}{% if a.ndmi_is_reconstructed %} (odtworzone ML){% endif %}{% else %}brak bezchmurnego zdjęcia{% endif %}</td></tr>
    </table>
  </div>
</div>
{% if chart %}<img class="map" src="data:image/png;base64,{{ chart }}" alt="Historia 10 lat">{% endif %}

<h2>2. Przyczyny niedoboru wody</h2>
<table>
  <tr><th>Czynnik</th><th>Udział</th><th>Wyjaśnienie</th></tr>
  <tr><td>Klimat (opad vs parowanie)</td><td>{{ "%.0f"|format(r.causes.climate_pct) }}%</td><td>{{ r.causes.explanations.get("klimat", "") }}</td></tr>
  <tr><td>Gleba (pojemność wodna)</td><td>{{ "%.0f"|format(r.causes.soil_pct) }}%</td><td>{{ r.causes.explanations.get("gleba", "") }}</td></tr>
  <tr><td>Spływ powierzchniowy (NMT)</td><td>{{ "%.0f"|format(r.causes.runoff_pct) }}%</td><td>{{ r.causes.explanations.get("splyw", "") }}</td></tr>
  <tr><td>Uprawa (faza, zapotrzebowanie)</td><td>{{ "%.0f"|format(r.causes.crop_pct) }}%</td><td>{{ r.causes.explanations.get("uprawa", "") }}</td></tr>
</table>
<div class="small">Metoda: {{ r.causes.method }}</div>

<h2>3. Zatrzymaj wodę tam, gdzie spadła – ranking działań</h2>
<div class="row">
  <div class="col">
    <table>
      <tr><th>#</th><th>Działanie</th><th>Efekt w roku {{ r.retention.what_if_default.reference_dry_year }}</th><th>Uwagi</th></tr>
      {% for m in r.retention.recommendations[:8] %}
      <tr><td>{{ m.priority_rank }}</td><td>{{ m.title }}</td>
          <td>−{{ "%.1f"|format(m.effect_yield_pp) }} p.p. straty plonu, {{ m.effect_reserve_days }} dni stresu mniej</td>
          <td>{% if m.requires_permit %}wymaga zgody Wód Polskich{% else %}{{ m.time_to_effect or "" }}{% endif %}</td></tr>
      {% endfor %}
    </table>
    {% set w = r.retention.what_if_default %}
    <p class="small">„Co jeśli” ({{ w.enabled_measures|join(", ") }}): strata plonu {{ "%.0f"|format(w.baseline_yield_loss_pct) }}% → {{ "%.0f"|format(w.scenario_yield_loss_pct) }}%,
      {{ w.delta_reserve_days }} dni rezerwy więcej, {{ "%.0f"|format(w.saved_water_mm) }} mm wody więcej dla roślin.</p>
  </div>
  {% if map_png %}<div class="col"><img class="map" src="data:image/png;base64,{{ map_png }}" alt="Mapa działki"></div>{% endif %}
</div>

<div class="page-break"></div>
<h2>4. Nawadnianie (krok opcjonalny, po działaniach retencyjnych)</h2>
<p><b>{{ r.irrigation.action_now }}</b></p>
<p>{{ irrigation_text }}</p>
<p class="small">Polityka: {{ r.irrigation.policy_used or "-" }} · pogoda w planie: {{ r.irrigation.forecast_mode }}</p>
{% if r.irrigation.strategies_10y %}
<table>
  <tr><th>Strategia (10 sezonów)</th><th>Śr. strata plonu</th><th>Woda [mm/sezon]</th><th>Przesiąk [mm]</th><th>WUE [p.p./100 mm]</th></tr>
  {% for s in r.irrigation.strategies_10y %}
  <tr><td>{{ s.strategy_name }}</td><td>{{ "%.1f"|format(s.avg_yield_loss_pct) }}%</td><td>{{ "%.0f"|format(s.avg_water_mm) }}</td><td>{{ "%.0f"|format(s.avg_deep_percolation_mm) }}</td><td>{{ "%.2f"|format(s.water_use_efficiency) }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<h2>Porady</h2>
{% for adv in r.advice %}
<div class="advice p{{ adv.priority }}"><b>{{ adv.title }}</b><br>{{ adv.text }}</div>
{% endfor %}

<h2>5. Źródła danych, niepewność i braki</h2>
<table>
  <tr><th>Kategoria</th><th>Źródło</th><th>Tryb</th><th>Data obserwacji</th><th>Rozdzielczość</th><th>Licencja</th></tr>
  {% for s in r.audit.sources %}
  <tr><td>{{ s.category }}</td><td>{{ s.source_name }}{% if s.message %}<br><span class="small">{{ s.message }}</span>{% endif %}</td>
      <td>{{ s.mode.value }}</td><td>{{ s.observation_date }}</td><td>{{ s.spatial_resolution }}</td><td>{{ s.license }}</td></tr>
  {% endfor %}
</table>
<div class="row">
  <div class="col"><b>Skala i świeżość danych</b><ul>{% for x in a.confidence.resolution_warnings %}<li>{{ x }}</li>{% endfor %}</ul></div>
  <div class="col"><b>Spójność i braki</b><ul>{% for x in a.confidence.consistency_warnings + a.confidence.missing_factors %}<li>{{ x }}</li>{% endfor %}</ul></div>
</div>
<p class="small"><b>Modele:</b> {% for k, v in r.audit.model_versions.items() %}{{ k }}: {{ v }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
<p class="small">Czas analizy {{ "%.1f"|format(r.audit.execution_time_s) }} s. {{ r.audit.rodo_notice }}
  Wynik jest wsparciem decyzji, a nie pomiarem na działce; nie zastępuje oceny komisji szacującej szkody.</p>
</body>
</html>
