# Python & tooling
__pycache__/
*.py[cod]
*$py.class
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Environment & secrets
.env
.env.*
*.key

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Data caches & large raw datasets
data/raw/
data/cache/
data/*.sqlite*
data/*.duckdb*
data/*.parquet
ml/runs/
*.log

# RL irrigation module (ml/rl_irrigator): raw data, HTTP cache, TensorBoard, intermediate checkpoints
ml/rl_irrigator/data/weather/*.parquet
ml/rl_irrigator/data/forecasts/*.parquet
ml/rl_irrigator/data/cache/
ml/rl_irrigator/runs/
ml/rl_irrigator/models/checkpoints/
# RL checkpoints: only the deployed runs are force-added (git add -f)
ml/rl_irrigator/models/**/*.zip
ml/rl_irrigator/models/**/*.pkl
ml/rl_irrigator/models/**/policy.npz
ml/rl_irrigator/data/holdout/weather/*.parquet
ml/rl_irrigator/data/holdout/forecasts/*.parquet
ml/rl_irrigator/models/**/dagger_student.npz
ml/rl_irrigator/models/**/policy_dominant.npz
