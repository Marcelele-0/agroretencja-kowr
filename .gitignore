# Python & tooling
__pycache__/
*.py[cod]
*$py.class
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Environment & secrets
.env
.env.*
*.key

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Data caches & large raw datasets
data/raw/
data/cache/
data/*.sqlite*
data/*.duckdb*
data/*.parquet
ml/runs/
*.log

# RL irrigation module (ml/rl_irrigator): downloaded data stays local (re-create it with
# ml/rl_irrigator/scripts/fetch_training_data.py); only the small manifests with sources and
# retrieval dates are versioned.
ml/rl_irrigator/data/**
!ml/rl_irrigator/data/**/
!ml/rl_irrigator/data/MANIFEST.json
!ml/rl_irrigator/data/soils/points.json
!ml/rl_irrigator/data/holdout/MANIFEST.json
!ml/rl_irrigator/data/holdout/soils/points.json
ml/rl_irrigator/runs/
ml/rl_irrigator/models/checkpoints/
# RL checkpoints: only the deployed model is force-added (git add -f)
ml/rl_irrigator/models/**/*.zip
ml/rl_irrigator/models/**/*.pkl
ml/rl_irrigator/models/**/*.npz
