# Python & tooling
__pycache__/
*.py[cod]
*$py.class
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Environment & secrets
.env
.env.*
!.env.example
*.key

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Data caches & large raw datasets
data/raw/
data/cache/
data/*.sqlite*
data/*.duckdb*
data/*.parquet
ml/runs/
*.log

# RL irrigation module (ml/rl_irrigator): the pre-fetched dataset (data/**/*.parquet, ~6 MB) is
# versioned; HTTP cache, TensorBoard logs and training checkpoints are not.
ml/rl_irrigator/data/cache/
ml/rl_irrigator/runs/
ml/rl_irrigator/models/checkpoints/
# RL checkpoints: only the deployed model is force-added (git add -f)
ml/rl_irrigator/models/**/*.zip
ml/rl_irrigator/models/**/*.pkl
ml/rl_irrigator/models/**/*.npz
