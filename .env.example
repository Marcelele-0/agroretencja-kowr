# Skopiuj do .env i zmień tylko to, czego potrzebujesz. Wszystkie wartości mają domyślne ustawienia.
# Plik .env jest w .gitignore - nie commituj kluczy.

# Łączny limit czasu analizy jednej działki [s]
AGRO_ANALYSIS_DEADLINE_S=25

# Jak długo trzymać gotową analizę w pamięci (PDF i "Co jeśli" bez ponownego liczenia) [s]
# AGRO_ANALYSIS_CACHE_TTL_S=3600

# Adresy frontendu dopuszczone przez CORS (lista JSON)
# AGRO_CORS_ORIGINS=["http://localhost:5173","https://twoj-adres-serwisu.pl"]

# Limit zapytań na minutę z jednego adresu do analizy, raportu, „co jeśli”, stref i RL (0 = wyłączony)
# AGRO_RATE_LIMIT_PER_MINUTE=120

# Katalog bufora (SQLite + BDOT10k)
# AGRO_CACHE_DIR=data/cache

# Open-Meteo: przy wdrożeniu w KOWR własna instancja (kod open source) albo plan komercyjny
# AGRO_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# AGRO_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# AGRO_OPEN_METEO_FORECAST_MODEL=ecmwf_ifs
# AGRO_OPEN_METEO_API_KEY=

# Sentinel-2 (Earth Search, bez konta)
# AGRO_S2_STAC_SEARCH_URL=https://earth-search.aws.element84.com/v1/search
# AGRO_S2_COLLECTION=sentinel-2-c1-l2a

# Usługi GUGiK / IUNG / ISRIC
# AGRO_ULDK_URL=https://uldk.gugik.gov.pl/
# AGRO_NMT_WCS_URL=https://mapy.geoportal.gov.pl/wss/service/PZGIK/NMT/GRID1/WCS/DigitalTerrainModelFormatTIFF
# Ile sekund analiza czeka na NMT 1 m (potem Copernicus DEM 30 m; pobieranie 1 m trwa dalej w tle)
# AGRO_NMT_GUGIK_TIMEOUT_S=4.5
# AGRO_IUNG_WMS_URL=https://sgeo.iung.pl/geoserver/Susza/wms
# AGRO_SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
# AGRO_IMGW_METEO_URL=https://danepubliczne.imgw.pl/api/data/meteo